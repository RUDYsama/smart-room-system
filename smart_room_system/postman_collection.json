{
  "info": {
    "_postman_id": "7b8e1a2f-9812-4c6e-bb89-53e7f9104a32",
    "name": "Smart Classroom & Meeting Room Reservation API",
    "description": "Comprehensive Postman test collection for Django REST Framework enterprise room booking system with SimpleJWT authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_tester\",\n  \"email\": \"student@itds.ac.th\",\n  \"password\": \"TesterPass123!\",\n  \"role\": \"user\",\n  \"phone_number\": \"0891234567\",\n  \"department\": \"Information Technology\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login (Obtain JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile", ""]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"admin1234\",\n  \"new_password\": \"AdminNewPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password", ""]
            }
          }
        }
      ]
    },
    {
      "name": "02 Rooms Management",
      "item": [
        {
          "name": "List Rooms",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", ""]
            }
          }
        },
        {
          "name": "Filter Rooms by Type and Capacity",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/?room_type=meeting&min_capacity=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", ""],
              "query": [
                {
                  "key": "room_type",
                  "value": "meeting"
                },
                {
                  "key": "min_capacity",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "Create Room (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Innovation Lab Alpha\",\n  \"room_number\": \"INN-201\",\n  \"building\": \"Engineering Wing\",\n  \"floor\": 2,\n  \"capacity\": 35,\n  \"room_type\": \"lab\",\n  \"amenities\": \"IoT kits, Oscilloscopes, Smart TV\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", ""]
            }
          }
        },
        {
          "name": "Get Room Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "1", ""]
            }
          }
        },
        {
          "name": "Check Room Availability Timeline",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/1/availability/?date=2026-10-22",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "1", "availability", ""],
              "query": [
                {
                  "key": "date",
                  "value": "2026-10-22"
                }
              ]
            }
          }
        }
      ]
    },
    {
